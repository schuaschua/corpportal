# Local docker compose only. Copy to .env (gitignored). Never used outside your laptop.
MSSQL_SA_PASSWORD=ChangeMeLocal123
REGION=local
# Synthetic data: seed, as-of business date (empty = today, Gulf time), RESEED=1 to wipe and regenerate.
SEED=42
AS_OF=
RESEED=0
# Portal "View lineage" link (Unity Catalog); empty disables the button.
LINEAGE_URL=
# Event flow: seconds between lake batches (Azure default 300), and the local password of the
# pipeline_writer SQL login the pipeline uses (created by db-init).
BATCH_CADENCE_SECONDS=120
PIPELINE_WRITER_PASSWORD=ChangeMePipeline123
