# Pinned platform add-on charts (ci/scripts/platform-addons.sh sources this file).
# Same versions in every region. Bump here only, then run the offline checks (README).
KONG_CHART_REPO=https://charts.konghq.com
KONG_CHART=kong/kong
KONG_CHART_VERSION=3.4.1

VAULT_CHART_REPO=https://helm.releases.hashicorp.com
VAULT_CHART=hashicorp/vault
VAULT_CHART_VERSION=0.34.1

MONITORING_CHART_REPO=https://prometheus-community.github.io/helm-charts
MONITORING_CHART=prometheus-community/kube-prometheus-stack
MONITORING_CHART_VERSION=91.8.2

# dev only (no Front Door): Let's Encrypt certificates for Kong
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART=jetstack/cert-manager
CERT_MANAGER_CHART_VERSION=v1.21.2
